# ============================================
# Super Personal Terminal Workstation Config
# ============================================

# 环境变量
export NOTES_VAULT="${NOTES_VAULT:-$HOME/Notes}"
export EDITOR="nvim"
export VISUAL="nvim"

# 确保笔记目录存在
[[ ! -d "$NOTES_VAULT" ]] && mkdir -p "$NOTES_VAULT/Daily"

# ============================================
# Starship Prompt
# ============================================
eval "$(starship init zsh)"

# ============================================
# Zoxide (智能目录跳转)
# ============================================
eval "$(zoxide init zsh)"

# ============================================
# FZF (模糊搜索)
# ============================================
if command -v fzf &> /dev/null; then
    # FZF 键绑定
    source <(fzf --zsh) 2>/dev/null || true
    
    # FZF Catppuccin Mocha 主题
    export FZF_DEFAULT_OPTS=" \
    --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
    --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
    --color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"
    
    # 使用 fd 替代 find
    if command -v fd &> /dev/null; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    fi
fi

# ============================================
# 别名 (Aliases)
# ============================================

# Eza (ls 替代品)
if command -v eza &> /dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza --icons --long --group-directories-first'
    alias la='eza --icons --long --all --group-directories-first'
    alias lt='eza --icons --tree --level=2 --group-directories-first'
    alias tree='eza --icons --tree --group-directories-first'
fi

# Bat (cat 替代品)
if command -v bat &> /dev/null; then
    alias cat='bat --paging=never'
    alias less='bat'
fi

# Zoxide (cd 替代品)
if command -v zoxide &> /dev/null; then
    alias cd='z'
fi

# Git (基础命令，lazygit 更推荐用于复杂操作)
alias gs='git status'
alias ga='git add'
alias gc='git commit -m'
alias gp='git push'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'

# 快速编辑配置
alias zshconfig="$EDITOR ~/.zshrc"
alias zshreload="source ~/.zshrc"
alias dotfiles="cd $(dirname $(readlink ~/.zshrc || echo ~/.zshrc))/.."

# ============================================
# 工作区函数
# ============================================

# 启动工作区
ws() {
    if command -v zellij &> /dev/null; then
        zellij --layout ws attach -c work 2>/dev/null || zellij --layout ws
    else
        echo "错误: zellij 未安装" >&2
        return 1
    fi
}

# 快速笔记：打开或追加今日日记
note() {
    local daily_note="$NOTES_VAULT/Daily/$(date +%Y-%m-%d).md"
    
    if [[ ! -f "$daily_note" ]]; then
        cat > "$daily_note" <<EOF
# $(date +%Y-%m-%d)

EOF
    fi
    
    if [[ -n "$1" ]]; then
        echo "- $(date +%H:%M) $*" >> "$daily_note"
        echo "✅ 已添加到 $(basename "$daily_note")"
    else
        $EDITOR "$daily_note"
    fi
}

# 新建笔记
new() {
    if [[ -z "$1" ]]; then
        echo "用法: new <标题>" >&2
        return 1
    fi
    
    local title="$*"
    local filename="$(date +%Y%m%d)-${title// /-}.md"
    local filepath="$NOTES_VAULT/$filename"
    
    if [[ -f "$filepath" ]]; then
        echo "⚠️  文件已存在，直接打开"
    else
        cat > "$filepath" <<EOF
# $title

$(date +%Y-%m-%d)

---

EOF
        echo "✅ 已创建: $filename"
    fi
    
    $EDITOR "$filepath"
}

# 搜索笔记
search() {
    if [[ -z "$1" ]]; then
        echo "用法: search <关键词>" >&2
        return 1
    fi
    
    if command -v rg &> /dev/null; then
        rg --color=always --heading --line-number "$1" "$NOTES_VAULT"
    else
        grep -r "$1" "$NOTES_VAULT"
    fi
}

# CTF writeup（可选功能）
ctf() {
    if [[ -z "$1" ]]; then
        echo "用法: ctf <题目名称>" >&2
        return 1
    fi
    
    local ctf_name="$1"
    local filename="$(date +%Y%m%d)-${ctf_name}.md"
    local filepath="$NOTES_VAULT/CTF/$filename"
    local template="$HOME/.config/templates/ctf-writeup.md"
    
    if [[ ! -f "$filepath" ]]; then
        if [[ -f "$template" ]]; then
            sed "s/{{TITLE}}/$ctf_name/g; s/{{DATE}}/$(date +%Y-%m-%d)/g" "$template" > "$filepath"
        else
            cat > "$filepath" <<EOF
# $ctf_name

**日期**: $(date +%Y-%m-%d)

## 题目

## 思路

## 解法

\`\`\`bash

\`\`\`

## Flag

\`\`\`
FLAG{}
\`\`\`
EOF
        fi
        echo "✅ 已创建: $filename"
    fi
    
    $EDITOR "$filepath"
    
    # 可选：启动 CTF 布局
    # zellij --layout ctf attach -c "ctf-$ctf_name" 2>/dev/null || true
}

# ============================================
# History 配置
# ============================================
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt SHARE_HISTORY

# ============================================
# 自动补全
# ============================================
autoload -Uz compinit
compinit

# ============================================
# 欢迎信息
# ============================================
if [[ "$TERM_PROGRAM" != "vscode" ]] && [[ -z "$ZELLIJ" ]]; then
    echo ""
    echo "✨ 工作区就绪"
    echo ""
    echo "  ws           启动工作区"
    echo "  note [text]  今日笔记"
    echo "  new <title>  新建笔记"
    echo ""
fi
